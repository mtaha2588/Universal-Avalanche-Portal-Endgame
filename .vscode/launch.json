{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Avalanche Portal (server)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Open portal in Chrome",
            "url": "http://127.0.0.1:5000/",
            "webRoot": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "Portal: server + Chrome",
            "configurations": ["Run Avalanche Portal (server)", "Open portal in Chrome"]
        }
    ]
}
