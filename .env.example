# Copy to .env and fill in. Never commit .env.

# Public Mapbox browser token (starts with pk.). Restrict it to your portal's URLs
# in the Mapbox account (Tokens -> URL restrictions). Leave empty to use the
# token-free MapLibre + Esri/OpenTopoMap fallback basemaps.
MAPBOX_TOKEN=

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

# Operational inputs older than this are flagged as stale
STALE_AFTER_HOURS=48
